{
  "name": "Autonomous Mobility Expansion",
  "dataColors": ["#2F6B9A", "#16A085", "#D97706", "#6B7280", "#7FA8C9", "#7CCBB9", "#F2B36B", "#A8AFB9"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2F6B9A",
  "good": "#16A085",
  "neutral": "#6B7280",
  "bad": "#D97706",
  "maximum": "#2F6B9A",
  "center": "#E5E7EB",
  "minimum": "#F7F9FC",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2937" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#1F2937" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#1F2937" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7F9FC" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F7F9FC" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 4 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#1F2937" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F2937" } }, "fontSize": 24 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#6B7280" } }, "fontSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontalColor": { "solid": { "color": "#E5E7EB" } }, "rowPadding": 3 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#1F2937" } }, "backColor": { "solid": { "color": "#F7F9FC" } } }]
      }
    }
  }
}
