.env
.env.*
!.env.example
*.p8
*.pem
*.key
*.pfx
rsa_key*
id_rsa*
id_ed25519*
*.ppk
*.jks
*.keystore
*.p12
.snowflake/
secrets/
credentials*
profiles.yml
.dbt/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# dbt artifacts
# ---------------------------------------------------------------
target/
logs/
dbt_packages/
*.log

# ---------------------------------------------------------------
# Data: raw downloads and large dumps stay out of version control.
# Provenance is documented in docs/data_sources.md instead.
# ---------------------------------------------------------------
data/*
!data/README.md
*.tmp
# Phase 6.5 agent drafts; the merged evidence/*.csv files are canonical
evidence/_staging/
*.zip
*.gz
*.7z
*.parquet
*.gdb/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg

# ---------------------------------------------------------------
# Power BI: ONLY the final dashboard is versioned. Every other .pbix/.pbit (backups, drafts, copies)
# stays local.
# ---------------------------------------------------------------
*.pbix
*.pbit
!powerbi/Autonomous_Mobility_Expansion_Strategy.pbix
*.pbix.bak
*.pbit.bak
~$*
.pbi/localSettings.json
.pbi/cache.abf

